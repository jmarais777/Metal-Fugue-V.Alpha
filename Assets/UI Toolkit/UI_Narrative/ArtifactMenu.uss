.Header {
    -unity-text-align: upper-center;
    font-size: 47px;
    color: rgb(0, 159, 1);
    -unity-font-definition: url("project://database/Assets/Fonts/AssetFonts/Quantico-Regular%20SDF.asset?fileID=11400000&guid=707b0b7b590f1584d9a4b8385827c478&type=2#Quantico-Regular SDF");
    border-top-width: 0;
    top: 69px;
    letter-spacing: 22px;
    -unity-text-outline-color: rgb(0, 252, 0);
    -unity-text-outline-width: 0.5px;
}

.Button {
    top: 2%;
    width: 28%;
    height: 8%;
    left: 7%;
    background-color: rgba(106, 90, 205, 0.29);
    color: rgb(8, 255, 0);
    border-left-color: rgb(153, 50, 204);
    border-right-color: rgb(153, 50, 204);
    border-top-color: rgb(153, 50, 204);
    border-bottom-color: rgb(153, 50, 204);
    border-top-width: 3px;
    border-left-width: 4px;
    border-bottom-width: 5px;
    border-right-width: 6px;
    text-shadow: 3px 2px 0 rgb(49, 255, 0);
    -unity-font-definition: url("project://database/Assets/Fonts/Quantico-Regular.ttf?fileID=12800000&guid=5ff25fa8fa2998e4dae2596ffec2625f&type=3#Quantico-Regular");
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}

.ButtonsNav:hover {
    border-left-color: rgb(0, 255, 216);
    border-right-color: rgb(0, 255, 216);
    border-top-color: rgb(0, 255, 216);
    border-bottom-color: rgb(0, 255, 216);
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    color: rgb(0, 231, 255);
    background-position-x: left 0;
    background-color: rgba(59, 94, 104, 0.37);
    background-size: 200% 100%;
    -unity-text-outline-color: rgb(0, 255, 216);
    -unity-text-outline-width: 27px;
    transition-property: border-left-color, border-right-color, border-bottom-color, border-top-color, color, background-image;
    transition-timing-function: ease-in-sine, ease-in-sine, ease-in-sine, ease-in-sine, ease-in-cubic, ease;
    transition-delay: 0.2s, 0.2s, 0.2s, 0.2s, 0.2s, 0.2s;
    transition-duration: 0.3s, 0.3s, 0.3s, 0.3s, 0.2s, 0.3s;
    -unity-material: url("");
}

.ButtonsNav {
    background-image: tbackground-image linear-gradient(to right, rgba(0, 87, 13, 0.16) 50%, rgb(58, 255, 0) 50%);
    background-size: 200% 100%;
    background-position: left;
    flex-shrink: 0;
    width: 19%;
    margin-top: 4%;
    visibility: visible;
    display: flex;
    flex-direction: row;
    -unity-font-definition: url("project://database/Assets/Fonts/AssetFonts/Quantico-Regular%20SDF.asset?fileID=11400000&guid=707b0b7b590f1584d9a4b8385827c478&type=2#Quantico-Regular SDF");
    background-color: rgba(59, 97, 0, 0.16);
    border-top-width: 3px;
    border-left-width: 3px;
    border-bottom-width: 3px;
    border-right-width: 3px;
    border-top-color: rgb(130, 182, 100);
    border-left-color: rgb(130, 182, 100);
    border-right-color: rgb(130, 182, 100);
    border-bottom-color: rgb(130, 182, 100);
    border-top-left-radius: -122px;
    border-bottom-left-radius: -122px;
    border-top-right-radius: -122px;
    border-bottom-right-radius: -122px;
    background-image: none;
    top: -28%;
    left: 73%;
    right: 0%;
    bottom: 0%;
    color: rgb(0, 255, 26);
    height: 13%;
    font-size: 18px;
    -unity-font-style: bold;
    text-shadow: 4px 4px 0 rgba(0, 255, 173, 0);
    min-width: 2px;
    background-position-x: right 20px;
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: top 0;
    -unity-material: url("");
}

.VisCont {
    flex-direction: collum;
    flex-grow: 1;
    background-color: rgb(0, 0, 0);
    border-top-color: rgb(148, 0, 211);
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-left-width: 8px;
    border-left-color: rgb(148, 0, 211);
    border-right-color: rgb(148, 0, 211);
    border-bottom-color: rgb(148, 0, 211);
}

.ArtifactText {
    white-space: normal;
    color: rgb(0, 255, 32);
    top: 24%;
    left: 89px;
    flex-wrap: wrap;
    -unity-font-definition: url("project://database/Assets/Fonts/AssetFonts/Quantico-Regular%20SDF.asset?fileID=11400000&guid=707b0b7b590f1584d9a4b8385827c478&type=2#Quantico-Regular SDF");
    width: 69%;
    height: 21%;
    text-overflow: clip;
    border-left-color: rgb(0, 255, 9);
    border-right-color: rgb(0, 255, 9);
    border-top-color: rgb(0, 255, 9);
    border-bottom-color: rgb(0, 255, 9);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    -unity-text-align: middle-left;
}
