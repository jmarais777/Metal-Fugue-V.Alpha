  m_Script: {fileID: 11500000, guid: c9eef8c22d9bca44a91848a744b04399, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue9Real
  ScavengerUIDOC: {fileID: 6489999130481143548}
  ScavengerDialogueMenu9Object: {fileID: 1227099628726839755}
  UILinker_9_real: {fileID: 393569811}
  InteractProximity: 3
  DialogueLines:
  - well, as you may have been able to tell, i am currently missing an arm..
  - 'It fell off after i tried wescaping one of those reaper bots at the old windmill '
  - If you find, and return my arm to me, i will tell you what you need to know
  - 'if you head east from here, you will see an old windmill. '
  - My arm shoudl be somehwere in that area. The reaper bot may still be there so
    be careful!
  DialogueIndex: 0
  quest: {fileID: 3882587743390503097}
  TransitionCondition13: {fileID: 1938566354}
  isUiDisplaying1: 0
