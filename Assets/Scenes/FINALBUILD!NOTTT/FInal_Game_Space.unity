  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue11Real
  ScavengerUIDOC: {fileID: 896579165663971462}
  ScavengerDialogueMenu11Object: {fileID: 9166974826232441556}
  UILinker_11_real: {fileID: 974257298}
  InteractProximity: 3
  DialogueLines:
  - You used to be an investigative Journalist.
  - You spread propoganda for the Vigil.
  - As you might have noticed, security is pretty tight around here. Even if you
    manage to kill all of the reapers, Those walls are to high to lcimb, and the
    main security gate is electrified
  - However, you may be able to exit throug the crycrombs.
  - Its located west of here..
  - I wil unlock it for you as  show of good faith.
  DialogueIndex: 0
  quest: {fileID: 3882587743390503097}
  TransitionCondition15: {fileID: 1474722332}
