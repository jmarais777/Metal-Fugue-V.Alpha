  m_Script: {fileID: 11500000, guid: 1a59c958ceb2d1645a406e3bb8ab5faa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue10Real
  ScavengerUIDOC: {fileID: 6930670682217837248}
  ScavengerDialogueMenu10Object: {fileID: 4086977770278731486}
  UILinker_10_real: {fileID: 1846972232}
  InteractProximity: 3
  DialogueLines:
  - well i'll be scrapped!
  - 'you made it back alive! '
  - 'and you managed to find my arm! '
  - 'I suppose that I was wrong to doubt you after you saved us earlier. '
  - 'it''s just that... Bots like you aren''t usually so down to earth '
  - But I guess you aren't relaly an upper class bot... not anymore atleast.
