  m_Script: {fileID: 11500000, guid: a271d55d084325e44af93c12ed588b81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue6Real
  ScavengerUIDOC: {fileID: 5581377367310229404}
  ScavengerDialogueMenu6Object: {fileID: 4637049517409454746}
  UILinker_6_real: {fileID: 2064839182}
  InteractProximity: 3
  DialogueLines:
  - Ahhh much better. I was starting to loose feeling in my mobility components.
  - Thanks for healping me---
  - wait a second
  - ...
  - ...
  - yeahhh! you're that robot that spread propganda for the Vigil!
  - 'HAHAHA at you now. Just another scrapped bot, in the scrapyard. '
  - You sure are lcuky that i only have one arm...
  - I'll let you keep that cannon as thanks for helping me out..
  - 'But don''t get it twisted! we are not friends... '
  - 'See taht old space shuttle? That''s where yo ucan fidn me if you ever need somethig...
    but it''ll come at a cost! '
  DialogueIndex: 0
  quest: {fileID: 3882587743390503097}
  TransitionCondition8: {fileID: 2065796718}
  ScavMove: {fileID: 0}
